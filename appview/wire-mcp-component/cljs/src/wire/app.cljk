(ns wire.app
  "wire-mcp-component appview frontend.

  Ported from `appview/wire-mcp-component/svelte/src/routes/+page.svelte`
  (SvelteKit) to reagent + re-frame, rendered with `jp-go-dds`
  (デジタル庁デザインシステム / DADS — the workspace-wide base UI/UX design
  system, ADR-2608050100). The original Svelte page was a static app-metadata
  card: a title/kind banner, a 3-fact strip (project / route count / xrpc),
  and three panels (Public Routes, Runtime Bindings, Source). This port keeps
  the same data values and section texts.

  This is a single-page app (ADR-2608080100): one document, one bundle, one
  mount point (`#app`). `public/index.html` is NOT hand-written — it is
  generated by `scripts/gen-page.cljs` via `jp-go-dds.page/->page`, which
  wires in the vendored `dds.css` and a single `<script src=\"js/app.js\">`.
  There is exactly one view here, so there is no client-side router: state
  lives in re-frame `app-db`, seeded once by the `::initialize` event.

  DOM mutation is the one ambient-authority effect this namespace performs
  (via `reagent.dom/render`), which is why it stays `.cljs` (host layer) per
  the workspace `.cljc`/`.kotoba` runtime-priority rule (`kotoba/host` — DOM
  mutation is explicitly host-layer capability, not something a
  `kotoba/pure` or `kotoba/app` profile owns today)."
  (:require [reagent.dom :as rdom]
            [re-frame.core :as rf]
            [jp-go-dds.core :as dds]))

;; ---------------------------------------------------------------------------
;; data — identical values to the original +page.svelte `app` object.

(def initial-db
  {:app {:title "Wire Mcp Component"
         :project "etzhayyim-project-wire"
         :name "wire-mcp-component"
         :kind "appview"
         :route-count 0
         :routes []
         :vars []
         :xrpc true
         :relative-path "60-apps/etzhayyim-project-wire/appview/wire-mcp-component/svelte/src/routes/+page.svelte"}})

;; ---------------------------------------------------------------------------
;; re-frame: events

(rf/reg-event-db
 ::initialize
 (fn [_ _] initial-db))

;; ---------------------------------------------------------------------------
;; re-frame: subs

(rf/reg-sub ::app (fn [db _] (:app db)))
(rf/reg-sub ::title (fn [db _] (get-in db [:app :title])))
(rf/reg-sub ::name (fn [db _] (get-in db [:app :name])))
(rf/reg-sub ::kind (fn [db _] (get-in db [:app :kind])))
(rf/reg-sub ::project (fn [db _] (get-in db [:app :project])))
(rf/reg-sub ::route-count (fn [db _] (get-in db [:app :route-count])))
(rf/reg-sub ::routes (fn [db _] (get-in db [:app :routes])))
(rf/reg-sub ::vars (fn [db _] (get-in db [:app :vars])))
(rf/reg-sub ::xrpc? (fn [db _] (get-in db [:app :xrpc])))
(rf/reg-sub ::relative-path (fn [db _] (get-in db [:app :relative-path])))

;; ---------------------------------------------------------------------------
;; view

(defn- fact [label value]
  [:div {:class "dds-ext-card"}
   [:span label]
   [:strong value]])

(defn- panel [{:keys [title]} & children]
  (into [:section {:class "dds-ext-section"} (dds/heading 2 title {:size "24"})] children))

(defn- routes-panel [routes]
  [panel {:title "Public Routes"}
   (if (seq routes)
     (into [:ul] (for [route routes] [:li route]))
     [:p "No public route is declared next to this app surface."])])

(defn- vars-panel [vars]
  [panel {:title "Runtime Bindings"}
   (if (seq vars)
     (into [:ul] (for [key vars] [:li key]))
     [:p "No public vars are declared in the nearest wrangler config."])])

(defn- source-panel [relative-path]
  [panel {:title "Source"}
   [:p relative-path]])

(defn app-view []
  (let [kind (rf/subscribe [::kind])
        title (rf/subscribe [::title])
        name (rf/subscribe [::name])
        project (rf/subscribe [::project])
        route-count (rf/subscribe [::route-count])
        xrpc? (rf/subscribe [::xrpc?])
        routes (rf/subscribe [::routes])
        vars (rf/subscribe [::vars])
        relative-path (rf/subscribe [::relative-path])]
    [:main {:class "dds-ext-container"}
     [:section {:class "dds-ext-section"}
      [:p (str "Cloudflare " @kind)]
      (dds/heading 1 @title {:size "45"})
      [:span @name]]
     [:section {:class "dds-ext-grid"}
      [fact "Project" @project]
      [fact "Routes" @route-count]
      [fact "XRPC" (if @xrpc? "enabled" "not configured")]]
     [routes-panel @routes]
     [vars-panel @vars]
     [source-panel @relative-path]]))

;; ---------------------------------------------------------------------------
;; mount

(defn render! []
  (when-let [el (js/document.getElementById "app")]
    (rdom/render [app-view] el)))

(defn ^:export main []
  (rf/dispatch-sync [::initialize])
  (render!))
